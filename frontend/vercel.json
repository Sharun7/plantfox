{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "config.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/plantfox_landing.html"
    },
    {
      "src": "/auth",
      "dest": "/plantfox_auth_landing.html"
    },
    {
      "src": "/login",
      "dest": "/plantfox_login.html"
    },
    {
      "src": "/register",
      "dest": "/plantfox_register.html"
    },
    {
      "src": "/dashboard",
      "dest": "/plantfox_dashboard.html"
    },
    {
      "src": "/splash",
      "dest": "/plantfox_splash.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
